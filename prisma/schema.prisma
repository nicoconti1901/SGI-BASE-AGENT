generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_superuser
}

enum TenantRole {
  tenant_admin
  process_owner
  contributor
  viewer
}

enum IsoStandard {
  ISO9001
  ISO14001
  ISO45001
}

enum GapStatus {
  pending
  not_applicable
  missing
  partial
  compliant
  automated
}

enum DocumentFate {
  keep
  replace
  create
  undecided
}

model User {
  id            String               @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  platformRole  PlatformRole?
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  gapAudits     GapAssessmentAudit[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenantId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Tenant {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  size         String?
  activity     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  memberships  Membership[]
  documents    Document[]
  requirements TenantRequirement[]

  @@map("tenant")
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("membership")
}

/// Controlled document with version history (Task 8).
model Document {
  id                  String              @id @default(cuid())
  tenantId            String
  title               String
  kind                String              @default("procedure")
  fate                DocumentFate        @default(undecided)
  tenantRequirementId String?
  currentVersionId    String?             @unique
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantRequirement   TenantRequirement?  @relation(fields: [tenantRequirementId], references: [id], onDelete: SetNull)
  versions            DocumentVersion[]   @relation("DocumentVersions")
  currentVersion      DocumentVersion?    @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantRequirementId])
  @@map("document")
}

model DocumentVersion {
  id            String     @id @default(cuid())
  documentId    String
  versionNumber Int
  storageKey    String
  fileName      String
  contentType   String
  sizeBytes     Int
  uploadedById  String?
  notes         String?
  createdAt     DateTime   @default(now())
  document      Document   @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentOf     Document?  @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_version")
}

/// Global ISO requirement catalog (Task 4). Shared across tenants.
model IsoRequirement {
  id         String              @id @default(cuid())
  standard   IsoStandard
  clauseCode String
  clauseKey  String              @unique
  title      String
  summary    String
  essential  Boolean             @default(false)
  tags       String[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  tenants    TenantRequirement[]

  @@index([standard, essential])
  @@map("iso_requirement")
}

/// Requirement assigned to a tenant from the catalog template (Task 5).
model TenantRequirement {
  id                String               @id @default(cuid())
  tenantId          String
  requirementId     String
  status            GapStatus            @default(pending)
  source            String               @default("template")
  notes             String?
  hasClientDocument Boolean              @default(false)
  documentFate      DocumentFate         @default(undecided)
  assessedAt        DateTime?
  assessedByUserId  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirement       IsoRequirement       @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  audits            GapAssessmentAudit[]
  documents         Document[]

  @@unique([tenantId, requirementId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_requirement")
}

/// Auditoría de cambios de gap por requisito (Task 7).
model GapAssessmentAudit {
  id                   String            @id @default(cuid())
  tenantId             String
  tenantRequirementId  String
  userId               String
  previousStatus       GapStatus
  newStatus            GapStatus
  previousNotes        String?
  newNotes             String?
  previousHasDocument  Boolean
  newHasDocument       Boolean
  previousDocumentFate DocumentFate
  newDocumentFate      DocumentFate
  createdAt            DateTime          @default(now())
  tenantRequirement    TenantRequirement @relation(fields: [tenantRequirementId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantRequirementId])
  @@map("gap_assessment_audit")
}
