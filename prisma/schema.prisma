generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_superuser
}

enum TenantRole {
  tenant_admin
  process_owner
  contributor
  viewer
}

enum IsoStandard {
  ISO9001
  ISO14001
  ISO45001
  /// Opt-in por empresa (SPEC-road-safety D2/D4). Requisitos con tag `sin-verificar`.
  ISO39001
}

enum GapStatus {
  pending
  not_applicable
  missing
  partial
  compliant
  automated
}

enum DocumentFate {
  keep
  replace
  create
  undecided
}

model User {
  id            String               @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean              @default(false)
  image         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  platformRole  PlatformRole?
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  gapAudits     GapAssessmentAudit[]
  notifications InAppNotification[]
  people        Person[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenantId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Tenant {
  id                    String                     @id @default(cuid())
  name                  String
  slug                  String                     @unique
  size                  String?
  activity              String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  memberships           Membership[]
  documents             Document[]
  requirements          TenantRequirement[]
  dueItems              DueItem[]
  offerActivations      TenantOfferActivation[]
  notifications         InAppNotification[]
  automationRuns        AutomationRun[]
  findings              Finding[]
  findingAttachments    FindingAttachment[]
  risks                 Risk[]
  opportunities         Opportunity[]
  operationalActions    Action[]
  actionAttachments     ActionAttachment[]
  auditPrograms         AuditProgram[]
  audits                Audit[]
  auditItems            AuditChecklistItem[]
  auditEvidence         AuditEvidenceAttachment[]
  auditReportFiles      AuditReportAttachment[]
  objectives            Objective[]
  indicators            Indicator[]
  incidentRecords       IncidentRecord[]
  incidentHealths       IncidentHealth[]
  incidentFollowUps     IncidentFollowUp[]
  exposurePeriods       ExposurePeriod[]
  exposureRevisions     ExposureRevision[]
  safetySettings        SafetyStatsSettings?
  roadEventDetails      RoadEventDetail[]
  vehicleKmPeriods      VehicleKmPeriod[]
  odometerResets        VehicleOdometerReset[]
  speedingPeriods       SpeedingPeriod[]
  roadSafetySettings    RoadSafetySettings?
  driverLicenses        DriverLicense[]
  safetyIndicatorLinks  SafetyIndicatorLink[]
  sites                 Site[]
  jobPositions          JobPosition[]
  jobTasks              JobTask[]
  people                Person[]
  masterDataAudits      MasterDataAudit[]
  moduleActivations     TenantModuleActivation[]
  suppliers             Supplier[]
  supplierSettings      SupplierSettings?
  supplierTemplates     SupplierCriteriaTemplate[]
  supplierDocTypes      SupplierDocumentType[]
  trainingCourses       Course[]
  trainingRequirements  TrainingRequirement[]
  trainingSessions      TrainingSession[]
  trainingRecords       TrainingRecord[]
  trainingEffectiveness TrainingEffectiveness[]
  trainingAttachments   TrainingAttachment[]
  trainingSettings      TrainingSettings?
  trainingAudits        TrainingAudit[]
  assets                Asset[]
  inspectionTemplates   InspectionTemplate[]
  inspections           Inspection[]
  inspectionPlans       InspectionPlan[]
  inspectionTargets     InspectionTarget[]
  inspectionAudits      InspectionAudit[]
  instrumentControls    InstrumentControl[]
  calibRecords          CalibrationRecord[]
  impacts               ImpactAssessment[]
  instrumentShipments   InstrumentShipment[]

  @@map("tenant")
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      TenantRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("membership")
}

/// Controlled document with version history (Task 8).
model Document {
  id                  String             @id @default(cuid())
  tenantId            String
  title               String
  kind                String             @default("procedure")
  fate                DocumentFate       @default(undecided)
  tenantRequirementId String?
  currentVersionId    String?            @unique
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantRequirement   TenantRequirement? @relation(fields: [tenantRequirementId], references: [id], onDelete: SetNull)
  versions            DocumentVersion[]  @relation("DocumentVersions")
  currentVersion      DocumentVersion?   @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantRequirementId])
  @@map("document")
}

model DocumentVersion {
  id            String    @id @default(cuid())
  documentId    String
  versionNumber Int
  storageKey    String
  fileName      String
  contentType   String
  sizeBytes     Int
  uploadedById  String?
  notes         String?
  createdAt     DateTime  @default(now())
  document      Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentOf     Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_version")
}

/// Global ISO requirement catalog (Task 4). Shared across tenants.
model IsoRequirement {
  id         String              @id @default(cuid())
  standard   IsoStandard
  clauseCode String
  clauseKey  String              @unique
  title      String
  summary    String
  essential  Boolean             @default(false)
  tags       String[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  tenants    TenantRequirement[]

  @@index([standard, essential])
  @@map("iso_requirement")
}

/// Requirement assigned to a tenant from the catalog template (Task 5).
model TenantRequirement {
  id                String               @id @default(cuid())
  tenantId          String
  requirementId     String
  status            GapStatus            @default(pending)
  source            String               @default("template")
  notes             String?
  hasClientDocument Boolean              @default(false)
  documentFate      DocumentFate         @default(undecided)
  assessedAt        DateTime?
  assessedByUserId  String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirement       IsoRequirement       @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  audits            GapAssessmentAudit[]
  documents         Document[]
  auditItems        AuditChecklistItem[]

  @@unique([tenantId, requirementId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_requirement")
}

/// Auditoría de cambios de gap por requisito (Task 7).
model GapAssessmentAudit {
  id                   String            @id @default(cuid())
  tenantId             String
  tenantRequirementId  String
  userId               String
  previousStatus       GapStatus
  newStatus            GapStatus
  previousNotes        String?
  newNotes             String?
  previousHasDocument  Boolean
  newHasDocument       Boolean
  previousDocumentFate DocumentFate
  newDocumentFate      DocumentFate
  createdAt            DateTime          @default(now())
  tenantRequirement    TenantRequirement @relation(fields: [tenantRequirementId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantRequirementId])
  @@map("gap_assessment_audit")
}

enum DueItemStatus {
  open
  closed
  cancelled
}

enum OfferKind {
  native
  integration
}

enum AutomationRunStatus {
  running
  succeeded
  failed
}

/// Catálogo global de automatizaciones (MVP: motor de vencimientos).
model AutomationOffer {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  description   String
  kind          OfferKind               @default(native)
  enabledGlobal Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  activations   TenantOfferActivation[]

  @@map("automation_offer")
}

model TenantOfferActivation {
  id            String          @id @default(cuid())
  tenantId      String
  offerId       String
  active        Boolean         @default(true)
  activatedAt   DateTime        @default(now())
  deactivatedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer         AutomationOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, offerId])
  @@index([tenantId, active])
  @@map("tenant_offer_activation")
}

/// Ítem genérico con vencimiento (doc, NC, indicador, etc.).
/// Módulos que usa cada empresa. Sin fila vale el defaultEnabled del catálogo (src/domain/modules/catalog.ts).
model TenantModuleActivation {
  id              String   @id @default(cuid())
  tenantId        String
  moduleKey       String
  enabled         Boolean
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@map("tenant_module_activation")
}

model DueItem {
  id               String              @id @default(cuid())
  tenantId         String
  title            String
  entityType       String
  entityId         String?
  dueAt            DateTime
  leadDays         Int                 @default(7)
  /// dueAt − leadDays: desde cuándo está "por vencer". Lo mantiene src/lib/automation.ts.
  remindAt         DateTime
  /// Quién lo resuelve: recibe el aviso en su resumen diario. Sin FK, como los demás ownerUserId; el scan valida la membresía.
  ownerUserId      String?
  /// Para agrupar los avisos por sede o persona (módulos de la Fase 5).
  siteId           String?
  personId         String?
  status           DueItemStatus       @default(open)
  lastRemindedAt   DateTime?
  lastReminderKind String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site             Site?               @relation(fields: [siteId], references: [id], onDelete: SetNull)
  person           Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  notifications    InAppNotification[]

  @@index([tenantId, status, dueAt])
  @@index([tenantId, status, remindAt])
  @@index([status, remindAt])
  @@index([ownerUserId])
  @@index([tenantId, entityType, entityId])
  @@map("due_item")
}

model InAppNotification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String?
  title     String
  body      String
  dueItemId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  dueItem   DueItem?  @relation(fields: [dueItemId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, readAt])
  @@map("in_app_notification")
}

model AutomationRun {
  id         String              @id @default(cuid())
  tenantId   String?
  offerCode  String
  status     AutomationRunStatus @default(running)
  summary    Json?
  error      String?
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  tenant     Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([offerCode, startedAt])
  @@index([tenantId, startedAt])
  @@map("automation_run")
}

enum WorkflowStatus {
  open
  in_progress
  closed
}

/// De dónde nace el hallazgo. inspection, incident y supplier quedan reservados para la Fase 5.
enum FindingOrigin {
  manual
  internal_audit
  external_audit
  indicator
  inspection
  incident
  supplier
  calibration
}

enum FindingType {
  nonconformity
  observation
  incident
  opportunity
}

enum FindingStatus {
  draft
  published
  in_progress
  verification
  closed
  cancelled
}

enum VerificationResult {
  effective
  not_effective
}

enum MeasureKind {
  corrective
  preventive
}

enum RcaStatus {
  incomplete
  confirmed
}

model Finding {
  id                String                   @id @default(cuid())
  tenantId          String
  type              FindingType
  status            FindingStatus            @default(draft)
  title             String
  description       String
  detectedAt        DateTime
  source            String?
  origin            FindingOrigin            @default(manual)
  location          String?
  severity          String?
  createdByUserId   String?
  publishedAt       DateTime?
  /// JSON RootCauseAnalysis (five_whys)
  rcaJson           Json?
  rcaStatus         RcaStatus                @default(incomplete)
  rootCause         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  measures          FindingMeasure[]
  notifyRecipients  FindingNotifyRecipient[]
  attachments       FindingAttachment[]
  risks             Risk[]
  opportunities     Opportunity[]
  auditId           String?
  audit             Audit?                   @relation(fields: [auditId], references: [id], onDelete: SetNull)
  auditItem         AuditChecklistItem?      @relation("AuditItemFinding")
  /// Ficha de accidente (Task 17): el vínculo vive en IncidentRecord, no hay columna acá.
  incidentRecord    IncidentRecord?
  /// Ciclo de vida (Task 10d) — SPEC-findings-lifecycle.md
  verificationDueAt DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?
  /// Desde cuándo hace falta una medida correctiva nueva (no eficaz / reapertura)
  reworkSince       DateTime?
  verifications     FindingVerification[]
  statusEvents      FindingStatusEvent[]
  supplierLink      SupplierFinding?
  /// Inspección que lo originó (Task 15): el vínculo vive en Inspection.findingId.
  inspection        Inspection?
  /// Evaluación de impacto de una calibración que lo originó (Task 16): el vínculo vive en ImpactAssessment.findingId.
  impactAssessment  ImpactAssessment?

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, origin])
  @@index([auditId])
  @@map("finding")
}

/// Intentos de verificación de eficacia (§10.2.1 d). Se conservan todos.
model FindingVerification {
  id                    String             @id @default(cuid())
  tenantId              String
  findingId             String
  result                VerificationResult
  evidence              String
  independenceException String?
  earlyReason           String?
  verifiedByUserId      String
  verifiedAt            DateTime           @default(now())
  finding               Finding            @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([tenantId, findingId])
  @@map("finding_verification")
}

/// Historial de estados del hallazgo (§10.2.2 información documentada).
model FindingStatusEvent {
  id          String         @id @default(cuid())
  tenantId    String
  findingId   String
  fromStatus  FindingStatus?
  toStatus    FindingStatus
  actorUserId String?
  reason      String?
  createdAt   DateTime       @default(now())
  finding     Finding        @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
  @@map("finding_status_event")
}

model FindingMeasure {
  id              String              @id @default(cuid())
  findingId       String
  tenantId        String
  kind            MeasureKind
  title           String
  description     String?
  ownerUserId     String
  dueAt           DateTime?
  linkedRootCause Boolean             @default(false)
  status          WorkflowStatus      @default(open)
  startedAt       DateTime?
  closedAt        DateTime?
  closedByUserId  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  finding         Finding             @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence        FindingAttachment[]

  @@index([tenantId, status])
  @@index([findingId])
  @@index([ownerUserId])
  @@map("finding_measure")
}

/// Adjuntos operativos (fotos, registros, evidencia de cierre). No es control documental formal.
enum FindingAttachmentKind {
  finding_doc
  measure_evidence
}

model FindingAttachment {
  id           String                @id @default(cuid())
  tenantId     String
  findingId    String
  measureId    String?
  kind         FindingAttachmentKind
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  label        String?
  uploadedById String?
  createdAt    DateTime              @default(now())
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finding      Finding               @relation(fields: [findingId], references: [id], onDelete: Cascade)
  measure      FindingMeasure?       @relation(fields: [measureId], references: [id], onDelete: Cascade)

  @@index([tenantId, findingId])
  @@index([measureId])
  @@map("finding_attachment")
}

model FindingNotifyRecipient {
  id        String   @id @default(cuid())
  findingId String
  userId    String
  createdAt DateTime @default(now())
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@unique([findingId, userId])
  @@index([userId])
  @@map("finding_notify_recipient")
}

/// --- Riesgos y oportunidades (ISO 9001:2026 §6.1) ---

enum RiskStatus {
  identified
  analyzing
  evaluated
  response_planned
  implementing
  effectiveness_review
  monitored
  closed
}

enum OpportunityStatus {
  discovered
  analyzing
  evaluated
  decision
  pursuing
  implementing
  benefit_review
  realized
  closed
}

enum SourceKind {
  process
  finding
  supplier
  change
  objective
  stakeholder
  indicator
  other
}

enum AssessmentMethod {
  qualitative
  probability_impact
}

enum RiskResponseDecision {
  mitigate
  accept
  transfer
  avoid
  monitor
  retain
}

enum OpportunityPursuitDecision {
  pursue_now
  pursue_later
  monitor
  investigate
  do_not_pursue
  close
}

enum ActionStatus {
  open
  in_progress
  completed
  cancelled
}

enum EffectivenessStatus {
  pending
  effective
  partially_effective
  not_effective
  not_applicable
}

enum ActionLinkTarget {
  risk
  opportunity
  finding
  supplier_evaluation
}

model Risk {
  id                   String                @id @default(cuid())
  tenantId             String
  title                String
  status               RiskStatus            @default(identified)
  /// causa
  cause                String                @default("")
  /// evento
  event                String                @default("")
  /// efecto
  effect               String                @default("")
  /// JSON string[]
  existingControlsJson Json                  @default("[]")
  sourceKind           SourceKind            @default(other)
  sourceLabel          String                @default("")
  findingId            String?
  responseDecision     RiskResponseDecision?
  responseRationale    String?
  responseOwnerUserId  String?
  nextReviewAt         DateTime?
  closeReason          String?
  closeRationale       String?
  createdByUserId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finding              Finding?              @relation(fields: [findingId], references: [id], onDelete: SetNull)
  assessments          RiskAssessment[]

  @@index([tenantId, status])
  @@index([tenantId, sourceKind])
  @@index([findingId])
  @@map("risk")
}

model RiskAssessment {
  id           String           @id @default(cuid())
  tenantId     String
  riskId       String
  version      Int
  method       AssessmentMethod
  /// qualitative level or P×I payload
  resultJson   Json
  rationale    String
  assessedById String?
  assessedAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  risk         Risk             @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([riskId, version])
  @@index([tenantId, riskId])
  @@map("risk_assessment")
}

model Opportunity {
  id                 String                      @id @default(cuid())
  tenantId           String
  title              String
  status             OpportunityStatus           @default(discovered)
  condition          String                      @default("")
  circumstance       String                      @default("")
  benefit            String                      @default("")
  sourceKind         SourceKind                  @default(other)
  sourceLabel        String                      @default("")
  findingId          String?
  pursuitDecision    OpportunityPursuitDecision?
  pursuitRationale   String?
  pursuitOwnerUserId String?
  benefitExpected    String?
  benefitObserved    String?
  nextReviewAt       DateTime?
  closeRationale     String?
  createdByUserId    String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finding            Finding?                    @relation(fields: [findingId], references: [id], onDelete: SetNull)
  assessments        OpportunityAssessment[]

  @@index([tenantId, status])
  @@index([tenantId, sourceKind])
  @@index([findingId])
  @@map("opportunity")
}

model OpportunityAssessment {
  id            String           @id @default(cuid())
  tenantId      String
  opportunityId String
  version       Int
  method        AssessmentMethod
  resultJson    Json
  rationale     String
  assessedById  String?
  assessedAt    DateTime         @default(now())
  createdAt     DateTime         @default(now())
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, version])
  @@index([tenantId, opportunityId])
  @@map("opportunity_assessment")
}

model Action {
  id                    String                  @id @default(cuid())
  tenantId              String
  title                 String
  description           String?
  status                ActionStatus            @default(open)
  ownerUserId           String
  dueAt                 DateTime?
  effectivenessStatus   EffectivenessStatus     @default(pending)
  effectivenessNote     String?
  effectivenessAt       DateTime?
  createdByUserId       String?
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links                 ActionLink[]
  attachments           ActionAttachment[]
  trainingEffectiveness TrainingEffectiveness[]
  /// Inspección que la originó (Task 15): el vínculo vive en Inspection.actionId.
  inspection            Inspection?
  impactLinks           ImpactAction[]

  @@index([tenantId, status])
  @@index([ownerUserId])
  @@index([tenantId, dueAt])
  @@map("action")
}

model ActionLink {
  id         String           @id @default(cuid())
  actionId   String
  targetType ActionLinkTarget
  targetId   String
  createdAt  DateTime         @default(now())
  action     Action           @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("action_link")
}

model ActionAttachment {
  id           String   @id @default(cuid())
  tenantId     String
  actionId     String
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  label        String?
  uploadedById String?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  action       Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([tenantId, actionId])
  @@map("action_attachment")
}

// ─── Auditorías internas (Task 11b) — SPEC-audits.md ───────────────────────

enum AuditProgramStatus {
  draft
  approved
  closed
}

enum AuditStatus {
  planned
  prepared
  in_progress
  reporting
  closed
  cancelled
}

enum ExternalAuditType {
  certification_initial
  surveillance
  recertification
  customer
}

enum AuditKind {
  internal
  external
}

enum AuditMode {
  onsite
  remote
  hybrid
}

enum AuditTeamRole {
  lead
  auditor
}

enum AuditItemResult {
  pending
  conforming
  nc_major
  nc_minor
  observation
  improvement
  not_applicable
}

/// Programa anual de auditorías de una empresa (uno por año).
model AuditProgram {
  id                 String             @id @default(cuid())
  tenantId           String
  year               Int
  objectives         String             @default("")
  frequencyRationale String             @default("")
  status             AuditProgramStatus @default(draft)
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits             Audit[]

  @@unique([tenantId, year])
  @@map("audit_program")
}

model Audit {
  id                    String                  @id @default(cuid())
  tenantId              String
  programId             String?
  kind                  AuditKind               @default(internal)
  /// Entidad que audita (solo kind = external): certificadora, cliente, autoridad.
  externalBody          String?
  externalType          ExternalAuditType?
  externalAuditor       String?
  /// Resultado o recomendación del organismo, tal como figura en su informe.
  externalResult        String?
  /// Plazo del organismo para responder las NC (genera DueItem).
  responseDueAt         DateTime?
  code                  String
  title                 String
  objective             String                  @default("")
  scope                 String                  @default("")
  standards             IsoStandard[]
  plannedStart          DateTime
  plannedEnd            DateTime
  mode                  AuditMode               @default(onsite)
  status                AuditStatus             @default(planned)
  impartialityException String?
  cancelReason          String?
  startedAt             DateTime?
  reportConclusion      String?
  reportStrengths       String?
  workersCommunicated   Boolean                 @default(false)
  reportIssuedAt        DateTime?
  closedAt              DateTime?
  createdByUserId       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program               AuditProgram?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  team                  AuditTeamMember[]
  auditees              AuditAuditee[]
  items                 AuditChecklistItem[]
  findings              Finding[]
  reportFiles           AuditReportAttachment[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, kind])
  @@index([programId])
  @@map("audit")
}

model AuditTeamMember {
  id      String        @id @default(cuid())
  auditId String
  userId  String
  role    AuditTeamRole
  audit   Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, userId])
  @@index([userId])
  @@map("audit_team_member")
}

/// A quién/qué se audita. userId opcional: un área puede no tener responsable cargado.
model AuditAuditee {
  id      String  @id @default(cuid())
  auditId String
  userId  String?
  area    String
  audit   Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@map("audit_auditee")
}

model AuditChecklistItem {
  id                  String                    @id @default(cuid())
  tenantId            String
  auditId             String
  tenantRequirementId String?
  question            String
  sortOrder           Int
  result              AuditItemResult           @default(pending)
  evidence            String?
  findingId           String?                   @unique
  updatedByUserId     String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audit               Audit                     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requirement         TenantRequirement?        @relation(fields: [tenantRequirementId], references: [id], onDelete: SetNull)
  finding             Finding?                  @relation("AuditItemFinding", fields: [findingId], references: [id], onDelete: SetNull)
  attachments         AuditEvidenceAttachment[]

  @@index([auditId, sortOrder])
  @@index([tenantRequirementId])
  @@map("audit_checklist_item")
}

model AuditEvidenceAttachment {
  id           String             @id @default(cuid())
  tenantId     String
  itemId       String
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime           @default(now())
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item         AuditChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId])
  @@map("audit_evidence_attachment")
}

/// Informe del auditor externo (PDF) adjunto a la auditoría.
model AuditReportAttachment {
  id           String   @id @default(cuid())
  tenantId     String
  auditId      String
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([tenantId, auditId])
  @@map("audit_report_attachment")
}

// ─── Objetivos e indicadores (Task 11c) — SPEC-indicators.md ───────────────

enum ObjectiveStatus {
  active
  achieved
  not_achieved
  cancelled
}

enum IndicatorDirection {
  higher_better
  lower_better
}

enum IndicatorFrequency {
  monthly
  quarterly
  semiannual
  annual
}

enum IndicatorKind {
  leading
  lagging
}

enum MeasurementStatus {
  on_target
  alert
  off_target
}

/// Objetivo del SGI (§6.2): medible, con responsable, fecha y plan.
model Objective {
  id              String          @id @default(cuid())
  tenantId        String
  code            String
  title           String
  description     String          @default("")
  standards       IsoStandard[]
  ownerUserId     String
  dueDate         DateTime
  plan            String          @default("")
  status          ObjectiveStatus @default(active)
  closingNote     String?
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicators      Indicator[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("objective")
}

/// Indicador (§9.1) que sigue el avance de un objetivo.
model Indicator {
  id             String                @id @default(cuid())
  tenantId       String
  objectiveId    String
  name           String
  formula        String                @default("")
  unit           String
  direction      IndicatorDirection
  target         Float
  alertThreshold Float?
  frequency      IndicatorFrequency
  kind           IndicatorKind
  ownerUserId    String
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  objective      Objective             @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  measurements   Measurement[]
  safetyLinks    SafetyIndicatorLink[]

  @@index([tenantId, objectiveId])
  @@index([ownerUserId])
  @@map("indicator")
}

/// Valor de un período. Un período se carga una sola vez; se corrige con registro.
model Measurement {
  id               String                  @id @default(cuid())
  tenantId         String
  indicatorId      String
  periodKey        String
  periodStart      DateTime
  value            Float
  status           MeasurementStatus
  analysis         String?
  findingId        String?
  recordedByUserId String
  recordedAt       DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  indicator        Indicator               @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  corrections      MeasurementCorrection[]

  @@unique([indicatorId, periodKey])
  @@index([tenantId, indicatorId, periodStart])
  @@map("measurement")
}

model MeasurementCorrection {
  id            String      @id @default(cuid())
  tenantId      String
  measurementId String
  previousValue Float
  newValue      Float
  reason        String
  byUserId      String
  createdAt     DateTime    @default(now())
  measurement   Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId])
  @@map("measurement_correction")
}

// ─── Datos maestros (Task 14): sedes, puestos, tareas y personas ───────────

enum SiteKind {
  office
  base
  worksite
  field
  camp
  plant
}

enum PersonEmployer {
  own
  contractor
}

enum PersonStatus {
  active
  inactive
}

/// Dónde: oficina, base, obrador, yacimiento, campamento o planta.
model Site {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  kind              SiteKind           @default(office)
  address           String?
  active            Boolean            @default(true)
  inactiveAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  basePeople        Person[]           @relation("PersonBaseSite")
  incidents         IncidentRecord[]
  exposures         ExposurePeriod[]
  people            PersonSite[]
  dueItems          DueItem[]
  suppliers         SupplierSite[]
  trainingSessions  TrainingSession[]
  assets            Asset[]
  inspections       Inspection[]
  inspectionPlans   InspectionPlan[]
  inspectionTargets InspectionTarget[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("site")
}

model JobPosition {
  id                   String                @id @default(cuid())
  tenantId             String
  name                 String
  active               Boolean               @default(true)
  inactiveAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  people               Person[]
  trainingRequirements TrainingRequirement[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("job_position")
}

/// Qué hace: una tarea puede ser crítica (altura, izaje, conducción, espacio confinado…).
model JobTask {
  id                   String                @id @default(cuid())
  tenantId             String
  name                 String
  critical             Boolean               @default(false)
  active               Boolean               @default(true)
  inactiveAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  people               PersonJobTask[]
  trainingRequirements TrainingRequirement[]
  inspections          Inspection[]
  roadSafetySettings   RoadSafetySettings[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("job_task")
}

/// Quién: nómina propia y de contratistas. No necesariamente usa el sistema (`userId` opcional).
/// Sin datos de salud. La baja es lógica: nunca se borra el historial.
model Person {
  id                    String            @id @default(cuid())
  tenantId              String
  employeeCode          String
  name                  String
  documentId            String?
  userId                String?
  employer              PersonEmployer    @default(own)
  contractorName        String?
  siteId                String
  positionId            String
  hiredAt               DateTime?
  /// Desde cuándo está en el puesto actual. NULL = desde el ingreso. Solo cambia al cambiar de puesto.
  positionSince         DateTime?
  status                PersonStatus      @default(active)
  inactiveAt            DateTime?
  /// Contratista del que depende (módulo Proveedores). `contractorName` sigue siendo el texto libre.
  supplierId            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  supplier              Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site                  Site              @relation("PersonBaseSite", fields: [siteId], references: [id], onDelete: Restrict)
  incidentHealths       IncidentHealth[]
  roadEventsDriven      RoadEventDetail[]
  speedingPeriods       SpeedingPeriod[]
  driverLicense         DriverLicense?
  position              JobPosition       @relation(fields: [positionId], references: [id], onDelete: Restrict)
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  extraSites            PersonSite[]
  jobTasks              PersonJobTask[]
  dueItems              DueItem[]
  trainingRecords       TrainingRecord[]
  assignedAssets        Asset[]
  performedInspections  Inspection[]
  supervisedInspections Inspection[]      @relation("InspectionSupervisor")

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([siteId])
  @@index([positionId])
  @@index([tenantId, supplierId])
  @@map("person")
}

/// Sedes adicionales donde rota una persona (además de su sede base).
model PersonSite {
  personId String
  siteId   String
  tenantId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([personId, siteId])
  @@index([tenantId, siteId])
  @@map("person_site")
}

model PersonJobTask {
  personId   String
  jobTaskId  String
  tenantId   String
  /// Desde cuándo tiene la tarea: arranca el plazo de gracia de sus capacitaciones (SPEC-training).
  assignedAt DateTime @default(now())
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  jobTask    JobTask  @relation(fields: [jobTaskId], references: [id], onDelete: Cascade)

  @@id([personId, jobTaskId])
  @@index([tenantId, jobTaskId])
  @@map("person_job_task")
}

/// Registro de quién cambió qué en los datos maestros.
model MasterDataAudit {
  id          String   @id @default(cuid())
  tenantId    String
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  summary     String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("master_data_audit")
}

// ─── Accidentabilidad (Task 17): SPEC-accident-stats.md ────────────────────
// Cada accidente es un Hallazgo `incident` con su ficha 1:1 (IncidentRecord). El vínculo vive acá,
// no en Finding. Los datos de salud van en IncidentHealth, aparte, para que un select descuidado
// del registro no los filtre. Todo lleva tenantId.

enum IncidentClassification {
  near_miss
  first_aid
  no_lost_time
  lost_time
  fatal
  occupational_disease
  /// Evento vial solo con daño material (SPEC-road-safety D9): no entra en IF, IG ni II.
  property_damage_only
}

/// El hecho: visible para quien ve el Hallazgo. Las columnas derivadas (occurredOn, periodMonth,
/// weekday, hourOfDay) las calcula `deriveEventPeriod` al guardar; nunca se tipean.
model IncidentRecord {
  id               String                 @id @default(cuid())
  tenantId         String
  findingId        String                 @unique
  siteId           String
  occurredAt       DateTime
  occurredOn       DateTime               @db.Date
  periodMonth      DateTime               @db.Date
  weekday          Int                    @db.SmallInt
  hourOfDay        Int                    @db.SmallInt
  classification   IncidentClassification
  inItinere        Boolean                @default(false)
  isRoad           Boolean                @default(false)
  employerKind     PersonEmployer
  /// Solo para `no_lost_time`: tareas restringidas.
  restrictedWork   Boolean                @default(false)
  /// Claves de las listas en código (src/domain/safety-stats/types.ts).
  accidentForm     String
  materialAgent    String
  /// Días reales perdidos (sin cargos). Un fatal guarda 0.
  lostDays         Int                    @default(0)
  /// Un `lost_time` sin fecha de reintegro está abierto.
  returnToWorkDate DateTime?              @db.Date
  /// 100 si es fatal; % de incapacidad permanente si lo hay; 0 si no.
  chargePct        Decimal                @default(0) @db.Decimal(5, 2)
  createdByUserId  String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finding          Finding                @relation(fields: [findingId], references: [id], onDelete: Restrict)
  site             Site                   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  health           IncidentHealth?
  followUps        IncidentFollowUp[]
  roadDetail       RoadEventDetail?

  @@index([tenantId, periodMonth, siteId])
  @@index([tenantId, classification])
  @@index([siteId, occurredOn])
  @@map("incident_record")
}

/// Datos de salud de la persona afectada. Sin diagnóstico libre ni adjuntos médicos.
model IncidentHealth {
  id               String         @id @default(cuid())
  tenantId         String
  incidentRecordId String         @unique
  /// Obligatoria salvo en un casi accidente (se valida en el dominio).
  affectedPersonId String?
  natureOfInjury   String?
  bodyPart         String?
  /// N.° de denuncia a la ART.
  artClaimNumber   String?
  deathDate        DateTime?      @db.Date
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentRecord   IncidentRecord @relation(fields: [incidentRecordId], references: [id], onDelete: Cascade)
  affectedPerson   Person?        @relation(fields: [affectedPersonId], references: [id], onDelete: Restrict)

  @@index([tenantId, affectedPersonId])
  @@map("incident_health")
}

/// Historial, solo se agrega: el vigente es el último. Cada cambio de clasificación o de días crea una fila.
model IncidentFollowUp {
  id               String                 @id @default(cuid())
  tenantId         String
  incidentRecordId String
  at               DateTime               @default(now())
  authorUserId     String?
  classification   IncidentClassification
  lostDays         Int
  returnToWorkDate DateTime?              @db.Date
  chargePct        Decimal                @default(0) @db.Decimal(5, 2)
  note             String?
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentRecord   IncidentRecord         @relation(fields: [incidentRecordId], references: [id], onDelete: Cascade)

  @@index([incidentRecordId, at])
  @@index([tenantId, at])
  @@map("incident_follow_up")
}

/// Horas trabajadas y dotación por sede, mes y grupo. 0 / 0 = «sin actividad», distinto de no haber cargado la fila.
model ExposurePeriod {
  id               String             @id @default(cuid())
  tenantId         String
  siteId           String
  periodMonth      DateTime           @db.Date
  employerKind     PersonEmployer
  hours            Int
  headcountAvg     Decimal            @db.Decimal(8, 2)
  recordedByUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site             Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  revisions        ExposureRevision[]

  @@unique([siteId, periodMonth, employerKind])
  @@index([tenantId, periodMonth])
  @@map("exposure_period")
}

/// Solo se agrega: toda corrección de un mes pasado deja valores anteriores, nuevos y motivo.
model ExposureRevision {
  id                   String         @id @default(cuid())
  tenantId             String
  exposurePeriodId     String
  previousHours        Int
  previousHeadcountAvg Decimal        @db.Decimal(8, 2)
  newHours             Int
  newHeadcountAvg      Decimal        @db.Decimal(8, 2)
  reason               String
  actorUserId          String?
  createdAt            DateTime       @default(now())
  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exposurePeriod       ExposurePeriod @relation(fields: [exposurePeriodId], references: [id], onDelete: Cascade)

  @@index([exposurePeriodId, createdAt])
  @@index([tenantId, createdAt])
  @@map("exposure_revision")
}

/// Ajustes de la empresa (uno por tenant). Sin fila valen los valores por defecto del dominio.
model SafetyStatsSettings {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  /// Días que se cargan por un fatal (D2).
  fatalChargeDays     Int      @default(6000)
  /// 1000 o 1000000 (D1).
  severityBase        Int      @default(1000)
  lostDaysCap         Int      @default(365)
  exposureDueDay      Int      @default(10)
  exposureOwnerUserId String?
  showOptionalIndices Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("safety_stats_settings")
}

// ─── Proveedores (Task 19) — SPEC-suppliers.md ─────────────────────────────
// Las fechas de calendario (@db.Date) viajan como medianoche UTC del día.
// Los CHECK (peso > 0, nota 1 a 5, motivo de criticidad, CUIT de 11 dígitos, plantilla publicada
// única por tipo) viven solo en el SQL de la migración: Prisma no los expresa.

enum SupplierType {
  product
  service
  contractor
}

enum SupplierCriticality {
  critical
  standard
  low
}

/// Derivado de la última evaluación no anulada; solo `inactive` se marca a mano.
enum SupplierStatus {
  potential
  approved
  conditional
  not_approved
  inactive
}

enum SupplierTemplateStatus {
  draft
  published
  retired
}

enum SupplierCriterionPhase {
  selection
  performance
  both
}

enum SupplierEvaluationKind {
  initial
  periodic
  event
}

enum SupplierEvaluationMode {
  full
  simplified
  declared
}

enum SupplierEvaluationResult {
  approved
  conditional
  not_approved
}

enum SupplierResultReason {
  score
  excluding_criterion
  declared
}

enum SupplierDocumentRecurrence {
  none
  monthly
}

enum SupplierFindingKind {
  quality
  delivery
  safety
  environment
  documentation
  claim
}

enum SupplierCommunicationKind {
  requirements
  evaluation_result
}

enum SupplierCommunicationChannel {
  email
  letter
  meeting
  other
}

/// A quién le compra la empresa: producto, servicio o contratista.
/// Las columnas de «resumen» las escribe solo `recomputeSupplierSummary` (src/lib/suppliers.ts).
model Supplier {
  id                   String                  @id @default(cuid())
  tenantId             String
  legalName            String
  tradeName            String?
  /// 11 dígitos normalizados. Opcional (proveedor extranjero); único por empresa cuando existe.
  taxId                String?
  type                 SupplierType
  category             String?
  criticality          SupplierCriticality     @default(standard)
  criticalityReason    String?
  /// Responsable interno (usuario de la empresa). Sin FK, como los demás ownerUserId.
  ownerUserId          String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  notes                String?
  status               SupplierStatus          @default(potential)
  inactiveAt           DateTime?
  inactiveReason       String?
  lastEvaluationId     String?
  lastEvaluatedAt      DateTime?               @db.Date
  lastScore            Decimal?                @db.Decimal(4, 1)
  nextEvaluationDueAt  DateTime?               @db.Date
  blockingDocExpiresAt DateTime?               @db.Date
  missingRequiredDocs  Int                     @default(0)
  missingBlockingDocs  Int                     @default(0)
  /// Primer instante en que necesita atención (reevaluación o documento bloqueante). Ordena la lista.
  attentionAt          DateTime?               @db.Date
  createdByUserId      String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sites                SupplierSite[]
  evaluations          SupplierEvaluation[]
  documents            SupplierDocument[]
  findings             SupplierFinding[]
  communications       SupplierCommunication[]
  people               Person[]

  @@unique([tenantId, taxId])
  @@index([tenantId, status])
  @@index([tenantId, criticality])
  @@index([tenantId, attentionAt])
  @@index([tenantId, legalName])
  @@map("supplier")
}

/// Sedes a las que atiende un proveedor. Sin filas = todas.
model SupplierSite {
  supplierId String
  siteId     String
  tenantId   String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([supplierId, siteId])
  @@index([tenantId, siteId])
  @@map("supplier_site")
}

/// Ajustes por empresa: periodicidad de la reevaluación (null = sin periodicidad) y avisos.
model SupplierSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  reevalCriticalMonths    Int?     @default(12)
  reevalStandardMonths    Int?     @default(24)
  reevalConditionalMonths Int?     @default(6)
  /// Días desde el alta para hacer la evaluación inicial.
  initialEvalDays         Int      @default(30)
  docWarnDays             Int      @default(30)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("supplier_settings")
}

/// Plantilla de criterios con versiones. Una versión publicada no se edita (se clona en borrador).
model SupplierCriteriaTemplate {
  id                String                 @id @default(cuid())
  tenantId          String
  supplierType      SupplierType
  version           Int
  status            SupplierTemplateStatus @default(draft)
  approvedMin       Int                    @default(80)
  conditionalMin    Int                    @default(60)
  changeNote        String?
  publishedAt       DateTime?
  publishedByUserId String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criteria          SupplierCriterion[]
  evaluations       SupplierEvaluation[]

  @@unique([tenantId, supplierType, version])
  @@index([tenantId, supplierType, status])
  @@map("supplier_criteria_template")
}

model SupplierCriterion {
  id          String                   @id @default(cuid())
  tenantId    String
  templateId  String
  position    Int
  name        String
  description String                   @default("")
  descriptor1 String                   @default("")
  descriptor3 String                   @default("")
  descriptor5 String                   @default("")
  weight      Int
  excluding   Boolean                  @default(false)
  allowNA     Boolean                  @default(false)
  phase       SupplierCriterionPhase   @default(both)
  /// Entra en la evaluación simplificada.
  basic       Boolean                  @default(false)
  template    SupplierCriteriaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@index([tenantId, templateId])
  @@map("supplier_criterion")
}

/// Inmutable: lo único que cambia es anularla (con motivo). Total y resultado los calcula el servidor.
model SupplierEvaluation {
  id                      String                    @id @default(cuid())
  tenantId                String
  supplierId              String
  kind                    SupplierEvaluationKind
  mode                    SupplierEvaluationMode
  /// Copia fija de lo evaluado: plantilla, versión, umbrales y criticidad de ese momento.
  templateId              String?
  templateVersion         Int?
  approvedMin             Int
  conditionalMin          Int
  criticalityAtEvaluation SupplierCriticality
  periodFrom              DateTime?                 @db.Date
  periodTo                DateTime?                 @db.Date
  evaluatedAt             DateTime                  @db.Date
  evaluatorUserId         String?
  totalScore              Decimal?                  @db.Decimal(4, 1)
  coverage                Decimal?                  @db.Decimal(4, 1)
  result                  SupplierEvaluationResult
  resultReason            SupplierResultReason
  comment                 String                    @default("")
  voidedAt                DateTime?
  voidedByUserId          String?
  voidReason              String?
  createdAt               DateTime                  @default(now())
  supplier                Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  template                SupplierCriteriaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items                   SupplierEvaluationItem[]
  findings                SupplierFinding[]
  communications          SupplierCommunication[]

  @@index([tenantId, supplierId, evaluatedAt])
  @@index([tenantId, result])
  @@map("supplier_evaluation")
}

/// Copia fija de cada criterio al momento de evaluar.
model SupplierEvaluationItem {
  id           String             @id @default(cuid())
  tenantId     String
  evaluationId String
  /// Trazabilidad hacia el criterio de la plantilla; sin FK a propósito (la copia es la verdad).
  criterionId  String?
  position     Int
  name         String
  description  String             @default("")
  weight       Int
  excluding    Boolean            @default(false)
  allowNA      Boolean            @default(false)
  /// 1 a 5, o null si no aplica.
  score        Int?
  comment      String             @default("")
  evaluation   SupplierEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([tenantId, evaluationId])
  @@map("supplier_evaluation_item")
}

model SupplierDocumentType {
  id               String                     @id @default(cuid())
  tenantId         String
  key              String
  name             String
  appliesTo        SupplierType[]
  required         Boolean                    @default(false)
  blocksEnablement Boolean                    @default(false)
  /// Sugerencia de vigencia al cargar el documento.
  validityMonths   Int?
  recurrence       SupplierDocumentRecurrence @default(none)
  note             String                     @default("")
  active           Boolean                    @default(true)
  position         Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        SupplierDocument[]

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("supplier_document_type")
}

/// El vigente de cada tipo es el último no anulado; se conserva el historial.
model SupplierDocument {
  id               String               @id @default(cuid())
  tenantId         String
  supplierId       String
  typeId           String
  issuedAt         DateTime?            @db.Date
  expiresAt        DateTime?            @db.Date
  storageKey       String
  fileName         String
  contentType      String
  sizeBytes        Int
  uploadedByUserId String?
  supersededAt     DateTime?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime             @default(now())
  supplier         Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type             SupplierDocumentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([tenantId, supplierId, typeId])
  @@index([tenantId, expiresAt])
  @@map("supplier_document")
}

/// Hallazgo originado en un proveedor (`Finding.origin = supplier`). El vínculo vive de este lado.
model SupplierFinding {
  id           String              @id @default(cuid())
  tenantId     String
  supplierId   String
  findingId    String              @unique
  kind         SupplierFindingKind
  evaluationId String?
  createdAt    DateTime            @default(now())
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  finding      Finding             @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evaluation   SupplierEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([tenantId, supplierId])
  @@map("supplier_finding")
}

/// Registro de lo comunicado al proveedor (§8.4.3). Solo se registra: no envía mails.
model SupplierCommunication {
  id              String                       @id @default(cuid())
  tenantId        String
  supplierId      String
  kind            SupplierCommunicationKind
  evaluationId    String?
  sentAt          DateTime                     @db.Date
  channel         SupplierCommunicationChannel
  recipientName   String?
  summary         String
  storageKey      String?
  fileName        String?
  contentType     String?
  sizeBytes       Int?
  createdByUserId String?
  createdAt       DateTime                     @default(now())
  supplier        Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evaluation      SupplierEvaluation?          @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  @@index([tenantId, supplierId, sentAt])
  @@map("supplier_communication")
}

// ─── Capacitaciones (Task 20) — SPEC-training.md ───────────────────────────
// El estado de cada persona en cada curso no se guarda: se calcula al leer (src/domain/training,
// src/lib/training.ts). Las invariantes que Prisma no expresa (CHECK, únicos parciales, índices
// parciales) están en la migración `training_matrix`.

enum CourseCategory {
  induction
  awareness
  safety
  environment
  quality
  driving
  other
}

enum CourseModality {
  in_person
  online
  on_the_job
  external
}

enum TrainingTargetKind {
  position
  task
  all
}

enum TrainingSessionStatus {
  planned
  held
  cancelled
}

enum TrainingLevel {
  senior
  middle
  operational
}

enum InstructorKind {
  internal
  external
}

enum TrainingResult {
  passed
  failed
}

enum TrainingValiditySource {
  computed
  certificate
}

enum TrainingRecordSource {
  session
  individual
  import
}

enum TrainingEffectivenessMethod {
  observation
  practical_test
  written_test
  indicator
  supervisor_review
}

/// Catálogo de cursos de la empresa. Baja lógica; se bloquea si tiene requisitos.
model Course {
  id                    String                @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  category              CourseCategory        @default(other)
  /// Qué normas ayuda a cumplir.
  standards             IsoStandard[]
  modality              CourseModality        @default(in_person)
  defaultHours          Decimal?              @db.Decimal(5, 2)
  /// Meses de vigencia (1–120). NULL = no vence.
  validityMonths        Int?
  /// Días de aviso previo al vencimiento (15–90).
  reminderDays          Int                   @default(30)
  requiresEffectiveness Boolean               @default(false)
  /// Plazo para evaluar la eficacia (30–180).
  effectivenessDays     Int                   @default(90)
  legalBasis            String?
  defaultProvider       String?
  /// Clave de la plantilla del catálogo sugerido de la que se importó (evita importarla dos veces).
  suggestedKey          String?
  active                Boolean               @default(true)
  inactiveAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirements          TrainingRequirement[]
  sessions              TrainingSession[]
  records               TrainingRecord[]

  @@unique([tenantId, name])
  @@unique([tenantId, suggestedKey])
  @@index([tenantId, active])
  @@map("training_course")
}

/// La matriz: qué curso se le exige a un puesto, a una tarea o a todo el personal.
model TrainingRequirement {
  id            String             @id @default(cuid())
  tenantId      String
  courseId      String
  targetKind    TrainingTargetKind
  positionId    String?
  jobTaskId     String?
  mandatory     Boolean            @default(true)
  /// Días de plazo desde el más tardío entre ingreso, asignación y vigencia (0–365).
  graceDays     Int                @default(30)
  effectiveFrom DateTime           @default(now()) @db.Date
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position      JobPosition?       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  jobTask       JobTask?           @relation(fields: [jobTaskId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetKind])
  @@index([tenantId, positionId])
  @@index([tenantId, jobTaskId])
  @@index([tenantId, courseId])
  @@map("training_requirement")
}

/// Una instancia de capacitación (realizada, planificada o cancelada). Se anula con motivo, nunca se borra.
model TrainingSession {
  id              String                @id @default(cuid())
  tenantId        String
  courseId        String
  status          TrainingSessionStatus @default(held)
  /// Fecha en que se dictó o en que está planificada.
  heldAt          DateTime              @db.Date
  /// Fecha con la que nació en el plan anual. NULL = sesión que no estaba planificada.
  plannedFor      DateTime?             @db.Date
  siteId          String?
  level           TrainingLevel?
  instructorKind  InstructorKind        @default(internal)
  instructorName  String                @default("")
  providerName    String?
  hours           Decimal?              @db.Decimal(5, 2)
  evaluatorUserId String?
  notes           String?
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course          Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  site            Site?                 @relation(fields: [siteId], references: [id], onDelete: SetNull)
  records         TrainingRecord[]
  attachments     TrainingAttachment[]

  @@index([tenantId, heldAt])
  @@index([tenantId, courseId])
  @@index([tenantId, siteId, heldAt])
  @@index([tenantId, plannedFor])
  @@map("training_session")
}

/// Lo que se hizo: una persona hizo un curso un día. El vencimiento es una foto del momento.
model TrainingRecord {
  id                String                 @id @default(cuid())
  tenantId          String
  personId          String
  courseId          String
  sessionId         String?
  completedAt       DateTime               @db.Date
  result            TrainingResult
  /// 0–100. Informativa: no aprueba ni reprueba sola.
  score             Int?
  /// Vencimiento guardado en el registro. NULL = no vence.
  validUntil        DateTime?              @db.Date
  validUntilSource  TrainingValiditySource @default(computed)
  source            TrainingRecordSource   @default(individual)
  certificateNumber String?
  providerName      String?
  notes             String?
  recordedByUserId  String?
  voidedAt          DateTime?
  voidedByUserId    String?
  voidReason        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person            Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  session           TrainingSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  effectiveness     TrainingEffectiveness?
  attachments       TrainingAttachment[]

  @@index([tenantId, personId, courseId, completedAt])
  @@index([tenantId, sessionId])
  @@map("training_record")
}

/// Eficacia de un registro aprobado de un curso que la exige (ISO 7.2 d).
model TrainingEffectiveness {
  id              String                       @id @default(cuid())
  tenantId        String
  recordId        String                       @unique
  dueAt           DateTime                     @db.Date
  evaluatorUserId String?
  status          EffectivenessStatus          @default(pending)
  method          TrainingEffectivenessMethod?
  note            String?
  evaluatedAt     DateTime?
  /// Acción de seguimiento si no fue eficaz (`Action`, sin modelo nuevo).
  actionId        String?
  rescheduledTo   DateTime?                    @db.Date
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  tenant          Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  record          TrainingRecord               @relation(fields: [recordId], references: [id], onDelete: Cascade)
  action          Action?                      @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([actionId])
  @@map("training_effectiveness")
}

/// Evidencia de una sesión (planilla firmada) o de un registro (certificado). Mismo almacenamiento que ActionAttachment.
model TrainingAttachment {
  id           String           @id @default(cuid())
  tenantId     String
  sessionId    String?
  recordId     String?
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session      TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  record       TrainingRecord?  @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordId])
  @@index([tenantId, sessionId])
  @@map("training_attachment")
}

/// Ajustes del módulo por empresa (una fila): responsable de avisos y sello de revisión de la matriz.
model TrainingSettings {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  ownerUserId            String?
  matrixReviewedAt       DateTime?
  matrixReviewedByUserId String?
  /// Quiénes participaron o fueron consultados (ISO 45001 §5.4).
  matrixReviewNote       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("training_settings")
}

/// Quién cambió qué en cursos, requisitos, anulaciones e importaciones.
model TrainingAudit {
  id          String   @id @default(cuid())
  tenantId    String
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  summary     String
  reason      String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("training_audit")
}

// ─── Inspecciones (Task 15): activos, plantillas versionadas e inspecciones ─
// Los tipos de activo viven en código (src/domain/inspections/asset-types); acá solo se guarda su clave.
// Los usuarios se guardan como id sin FK (igual que los demás ownerUserId).

enum AssetStatus {
  in_service
  out_of_service
  retired
}

enum AssetOwnership {
  own
  rented
  contractor
}

enum InspectionTemplateScope {
  asset
  area
  activity
}

enum InspectionIntervalUnit {
  days
  months
}

enum InspectionItemCriticality {
  critical
  major
  minor
}

enum InspectionItemKind {
  check
  number
  text
  reading
}

enum InspectionStatus {
  draft
  closed
}

enum InspectionResult {
  fit
  fit_with_observations
  unfit
}

enum InspectionAnswerValue {
  conform
  nonconform
  na
}

enum InspectionAttachmentKind {
  photo
  evidence
  destruction
}

/// Equipo que se controla: hoy extintores. Un activo con inspecciones no se borra, se da de baja.
model Asset {
  id                String                 @id @default(cuid())
  tenantId          String
  /// Clave del tipo en el registro de código (p. ej. `extinguisher`).
  typeKey           String
  /// Único por empresa, en mayúsculas, hasta 30 caracteres.
  code              String
  description       String
  siteId            String
  sector            String?
  status            AssetStatus            @default(in_service)
  statusReason      String?
  statusChangedAt   DateTime               @default(now())
  ownership         AssetOwnership         @default(own)
  contractorName    String?
  /// Persona (no usuario) a cargo del activo; muchos operadores no tienen login.
  assignedPersonId  String?
  /// Validado con el esquema zod del tipo.
  attributes        Json
  attributesVersion Int                    @default(1)
  retiredAt         DateTime?
  retirementReason  String?
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site              Site                   @relation(fields: [siteId], references: [id], onDelete: NoAction)
  assignedPerson    Person?                @relation(fields: [assignedPersonId], references: [id], onDelete: SetNull)
  dueDates          AssetDueDate[]
  statusEvents      AssetStatusEvent[]
  inspections       Inspection[]
  plans             InspectionPlan[]
  attachments       InspectionAttachment[]
  // Task 16 (equipos de medición): control metrológico y sus registros.
  instrControl      InstrumentControl?
  calibRecords      CalibrationRecord[]
  refForRecords     CalibrationRecord[]    @relation("CalibrationReferenceStandard")
  impacts           ImpactAssessment[]
  shipments         InstrumentShipment[]
  // Task 18 (seguridad vial): vehículos de la flota.
  roadEvents        RoadEventDetail[]
  kmPeriods         VehicleKmPeriod[]
  odometerResets    VehicleOdometerReset[]
  speedingPeriods   SpeedingPeriod[]

  @@unique([tenantId, code])
  @@index([tenantId, typeKey, status])
  @@index([tenantId, siteId, status])
  @@index([siteId])
  @@index([assignedPersonId])
  @@map("asset")
}

/// Vencimiento documental del activo (mantenimiento, prueba hidráulica…). Mantiene un DueItem abierto.
model AssetDueDate {
  id         String    @id @default(cuid())
  tenantId   String
  assetId    String
  kind       String
  dueAt      DateTime  @db.Date
  lastDoneAt DateTime? @db.Date
  /// N.º de certificado o comprobante.
  reference  String?
  leadDays   Int       @default(30)
  /// Si vence, impide usar el activo.
  blocking   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind])
  @@index([tenantId, dueAt])
  @@map("asset_due_date")
}

/// Historial de cambios de estado: responde «¿por qué está fuera de servicio y quién lo dijo?».
model AssetStatusEvent {
  id           String       @id @default(cuid())
  tenantId     String
  assetId      String
  fromStatus   AssetStatus?
  toStatus     AssetStatus
  reasonCode   String
  inspectionId String?
  byUserId     String?
  note         String?
  createdAt    DateTime     @default(now())
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([tenantId, createdAt])
  @@map("asset_status_event")
}

/// Plantilla de inspección de la empresa. Se siembra desde el anexo del SPEC y el cliente la edita (siempre creando una versión nueva).
model InspectionTemplate {
  id                String                      @id @default(cuid())
  tenantId          String
  key               String
  name              String
  scope             InspectionTemplateScope
  assetTypeKey      String?
  /// Nulo: control previo al uso o sin calendario.
  intervalUnit      InspectionIntervalUnit?
  intervalValue     Int?
  leadDays          Int                         @default(7)
  reinspectionDays  Int                         @default(7)
  findingOnCritical Boolean                     @default(false)
  canReinstate      Boolean                     @default(false)
  retireOnUnfit     Boolean                     @default(false)
  activeVersionId   String?
  active            Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activeVersion     InspectionTemplateVersion?  @relation("TemplateActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions          InspectionTemplateVersion[] @relation("TemplateVersions")
  inspections       Inspection[]
  plans             InspectionPlan[]
  targets           InspectionTarget[]

  @@unique([tenantId, key])
  @@map("inspection_template")
}

/// Inmutable: nunca se actualiza ni se borra. Editar la plantilla crea la versión siguiente.
model InspectionTemplateVersion {
  id              String                   @id @default(cuid())
  tenantId        String
  templateId      String
  version         Int
  note            String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  template        InspectionTemplate       @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  activeFor       InspectionTemplate[]     @relation("TemplateActiveVersion")
  items           InspectionTemplateItem[]
  inspections     Inspection[]

  @@unique([templateId, version])
  @@map("inspection_template_version")
}

model InspectionTemplateItem {
  id          String                    @id @default(cuid())
  tenantId    String
  versionId   String
  /// Estable entre versiones: permite compararlas.
  code        String
  section     String
  sortOrder   Int
  text        String
  help        String?
  /// Se ignora en los ítems que no puntúan (texto y lectura).
  criticality InspectionItemCriticality @default(minor)
  kind        InspectionItemKind        @default(check)
  unit        String?
  minValue    Float?
  maxValue    Float?
  naAllowed   Boolean                   @default(true)
  photoOnNc   Boolean                   @default(false)
  required    Boolean                   @default(true)
  /// `odometer_km` u `hours`.
  readingKey  String?
  /// El valor lo deriva el sistema, p. ej. `{ "dueKind": "hydrostatic_test" }`.
  autoSource  Json?
  /// Condición sobre un atributo del activo o un dato de contexto.
  appliesWhen Json?
  version     InspectionTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  answers     InspectionAnswer[]

  @@unique([versionId, code])
  @@index([versionId, sortOrder])
  @@map("inspection_template_item")
}

model Inspection {
  id                  String                    @id @default(cuid())
  tenantId            String
  templateId          String
  /// Versión de la plantilla con la que se empezó: fija los ítems de esta inspección para siempre.
  versionId           String
  assetId             String?
  /// Siempre se guarda la sede (la del activo, o la elegida si se inspecciona un área).
  siteId              String
  sector              String?
  /// Solo en la auditoría de seguridad en campo (contexto de la tarea auditada).
  jobTaskId           String?
  contractorName      String?
  supervisorPersonId  String?
  /// `height` / `confined_space` / `lifting`: deciden qué ítems de «tareas especiales» aplican.
  specialTasks        String[]
  inspectorUserId     String
  /// Quien hizo el control si no es el usuario que lo carga.
  performedByPersonId String?
  status              InspectionStatus          @default(draft)
  startedAt           DateTime                  @default(now())
  inspectedAt         DateTime                  @db.Date
  closedAt            DateTime?
  result              InspectionResult?
  scorePct            Float?
  applicableCount     Int?
  conformCount        Int?
  nonconformCount     Int?
  readingKm           Int?
  readingHours        Float?
  notes               String?
  /// Hallazgo borrador y acción de seguimiento que nacieron de las no conformidades (uno por inspección).
  findingId           String?                   @unique
  actionId            String?                   @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finding             Finding?                  @relation(fields: [findingId], references: [id], onDelete: SetNull)
  action              Action?                   @relation(fields: [actionId], references: [id], onDelete: SetNull)
  corrections         InspectionCorrection[]
  template            InspectionTemplate        @relation(fields: [templateId], references: [id], onDelete: NoAction)
  templateVersion     InspectionTemplateVersion @relation(fields: [versionId], references: [id], onDelete: NoAction)
  asset               Asset?                    @relation(fields: [assetId], references: [id], onDelete: NoAction)
  site                Site                      @relation(fields: [siteId], references: [id], onDelete: NoAction)
  performedBy         Person?                   @relation(fields: [performedByPersonId], references: [id], onDelete: SetNull)
  jobTask             JobTask?                  @relation(fields: [jobTaskId], references: [id], onDelete: SetNull)
  supervisor          Person?                   @relation("InspectionSupervisor", fields: [supervisorPersonId], references: [id], onDelete: SetNull)
  answers             InspectionAnswer[]
  attachments         InspectionAttachment[]
  lastForPlans        InspectionPlan[]

  @@index([tenantId, status, inspectedAt(sort: Desc)])
  @@index([tenantId, siteId, inspectedAt(sort: Desc)])
  @@index([tenantId, assetId, inspectedAt(sort: Desc)])
  @@index([tenantId, templateId, inspectedAt(sort: Desc)])
  @@index([tenantId, result, inspectedAt(sort: Desc)])
  @@index([versionId])
  @@index([siteId])
  @@map("inspection")
}

/// Una fila por ítem aplicable, creada al abrir el borrador: «completa» es «ninguna sin responder».
model InspectionAnswer {
  id           String                 @id @default(cuid())
  tenantId     String
  inspectionId String
  itemId       String
  value        InspectionAnswerValue?
  numberValue  Float?
  textValue    String?
  comment      String?
  /// El valor lo calcula el sistema (vencimientos del activo) y el inspector no lo puede pisar.
  autoDerived  Boolean                @default(false)
  answeredAt   DateTime?
  inspection   Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item         InspectionTemplateItem @relation(fields: [itemId], references: [id], onDelete: NoAction)
  attachments  InspectionAttachment[]

  @@unique([inspectionId, itemId])
  @@index([itemId])
  @@map("inspection_answer")
}

/// Corrección de una respuesta de una inspección cerrada (molde de MeasurementCorrection): nada se edita en silencio.
model InspectionCorrection {
  id             String            @id @default(cuid())
  tenantId       String
  inspectionId   String
  answerId       String
  /// Valor anterior y nuevo, legibles («conform», «nonconform», «na» o el número).
  previousValue  String?
  newValue       String?
  previousResult InspectionResult?
  newResult      InspectionResult
  reason         String
  byUserId       String
  createdAt      DateTime          @default(now())
  inspection     Inspection        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, inspectionId, createdAt])
  @@map("inspection_correction")
}

/// Fotos y evidencias (molde de FindingAttachment). Al menos una de `inspectionId` o `assetId` (CHECK en la migración).
model InspectionAttachment {
  id           String                   @id @default(cuid())
  tenantId     String
  inspectionId String?
  answerId     String?
  assetId      String?
  kind         InspectionAttachmentKind @default(photo)
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  label        String?
  uploadedById String?
  createdAt    DateTime                 @default(now())
  inspection   Inspection?              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  answer       InspectionAnswer?        @relation(fields: [answerId], references: [id], onDelete: Cascade)
  asset        Asset?                   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, inspectionId])
  @@index([answerId])
  @@index([assetId])
  @@map("inspection_attachment")
}

/// Programa y lectura rápida: una fila por (plantilla, sujeto). «Vencidas» y «último resultado» salen de acá
/// sin agregar sobre la tabla grande de inspecciones.
model InspectionPlan {
  id               String             @id @default(cuid())
  tenantId         String
  templateId       String
  /// `asset:<id>` o `site:<id>`.
  subjectKey       String
  assetId          String?
  siteId           String
  lastInspectionId String?
  lastInspectedAt  DateTime?          @db.Date
  lastResult       InspectionResult?
  nextDueAt        DateTime?          @db.Date
  /// Falso cuando el programa se cerró (activo dado de baja).
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template         InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction)
  asset            Asset?             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  site             Site               @relation(fields: [siteId], references: [id], onDelete: NoAction)
  lastInspection   Inspection?        @relation(fields: [lastInspectionId], references: [id], onDelete: SetNull)

  @@unique([templateId, subjectKey])
  @@index([tenantId, nextDueAt])
  @@index([tenantId, templateId, lastInspectedAt])
  @@index([tenantId, siteId, nextDueAt])
  @@index([assetId])
  @@map("inspection_plan")
}

/// Registro de quién cambió qué: altas, ediciones, bajas, importaciones y renovaciones de activos.
model InspectionAudit {
  id          String   @id @default(cuid())
  tenantId    String
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  summary     String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("inspection_audit")
}

// ─── Task 16: equipos de medición y calibraciones (SPEC-calibration.md) ────────────────────────────

enum CalibrationKind {
  calibration
  verification
}

enum CalibrationRecordStatus {
  draft
  closed
  voided
}

enum CalibrationTraceability {
  nmi
  accredited_lab
  other_lab
  in_house
}

enum CalibrationDecisionRule {
  guard_band
  simple_acceptance
  certificate_statement
}

enum CalibrationBasis {
  points
  certificate_statement
}

enum CalibrationLabStatement {
  conforme
  no_conforme
}

enum CalibrationResult {
  apt
  not_apt
}

enum CalibrationAsFoundResult {
  apt
  not_apt
  not_evaluated
}

enum CalibrationStage {
  as_found
  as_left
}

enum ImpactAssessmentTrigger {
  as_found_not_apt
  adjusted_without_as_found
  functional_check_failed
}

enum ImpactAssessmentStatus {
  pending
  completed
}

enum ImpactAssessmentOutcome {
  no_affected_results
  affected_results_actioned
  cannot_determine
}

/// Control metrológico del equipo (1:1 con Asset de tipo measuring_equipment). Las columnas «derivadas» las escribe
/// recomputeInstrumentControl y se pueden reconstruir siempre desde los registros; nadie las edita.
model InstrumentControl {
  id                         String                  @id @default(cuid())
  tenantId                   String
  assetId                    String                  @unique
  /// Clave de la magnitud en el catálogo del código (src/domain/calibration/types.ts).
  magnitude                  String
  isReferenceStandard        Boolean                 @default(false)
  criticalUse                Boolean                 @default(false)
  criticalUseReason          String?
  requiresCalibration        Boolean                 @default(false)
  calibrationIntervalMonths  Int?
  requiresVerification       Boolean                 @default(false)
  verificationIntervalMonths Int?
  intervalReason             String?
  /// Obligatoria si no se exige ni calibración ni verificación.
  noControlReason            String?
  decisionRule               CalibrationDecisionRule @default(guard_band)
  decisionRuleReason         String?
  alertLeadDays              Int                     @default(30)
  /// Canales (sensor/magnitud/unidad/rango/EMP), validado con zod.
  channels                   Json                    @default("[]")
  // Derivadas
  calibrationValidUntil      DateTime?               @db.Date
  verificationValidUntil     DateTime?               @db.Date
  /// El menor de los vencimientos exigidos.
  nextDueAt                  DateTime?               @db.Date
  lastDecision               CalibrationResult?
  impactPending              Boolean                 @default(false)
  inCalibrationSince         DateTime?               @db.Date
  expectedReturnAt           DateTime?               @db.Date
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  tenant                     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                      Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, nextDueAt])
  @@index([tenantId, magnitude])
  @@index([tenantId, impactPending])
  @@map("instrument_control")
}

/// Calibración o verificación de un equipo. Cerrado no se edita: se anula con motivo y se vuelve a cargar.
model CalibrationRecord {
  id                       String                    @id @default(cuid())
  tenantId                 String
  assetId                  String
  kind                     CalibrationKind
  status                   CalibrationRecordStatus   @default(draft)
  voidReason               String?
  voidedByUserId           String?
  voidedAt                 DateTime?
  /// Fecha de ejecución (de ahí corre la vigencia), no la del certificado.
  performedAt              DateTime                  @db.Date
  certificateNumber        String?
  certificateIssuedAt      DateTime?                 @db.Date
  labName                  String
  traceability             CalibrationTraceability
  accreditationBody        String?
  accreditationNumber      String?
  accreditationScopeCovers Boolean?
  traceabilityBasis        String?
  /// Patrón usado en una verificación interna: otro equipo registrado.
  referenceStandardAssetId String?
  conditions               String?
  adjusted                 Boolean                   @default(false)
  /// Snapshot de la regla al cerrar: cambiar el equipo después no cambia este resultado.
  ruleApplied              CalibrationDecisionRule
  ruleReasonApplied        String?
  basis                    CalibrationBasis          @default(points)
  labStatement             CalibrationLabStatement?
  labStatementSpec         String?
  labDecisionRule          String?
  // Resultados calculados al cerrar
  asFoundResult            CalibrationAsFoundResult?
  asLeftResult             CalibrationResult?
  intervalMonthsApplied    Int?
  validUntil               DateTime?                 @db.Date
  loadedByUserId           String
  closedAt                 DateTime?
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset                    Asset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  referenceStandard        Asset?                    @relation("CalibrationReferenceStandard", fields: [referenceStandardAssetId], references: [id], onDelete: SetNull)
  points                   CalibrationPoint[]
  attachments              CalibrationAttachment[]
  impactAssessment         ImpactAssessment?

  @@index([tenantId, assetId, performedAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([referenceStandardAssetId])
  @@map("calibration_record")
}

/// Un punto medido. nominal/medido/incertidumbre los carga la persona; error, EMP y «pasa» se calculan al cerrar.
model CalibrationPoint {
  id          String            @id @default(cuid())
  tenantId    String
  recordId    String
  channelKey  String
  stage       CalibrationStage  @default(as_found)
  nominal     Decimal           @db.Decimal(20, 8)
  measured    Decimal           @db.Decimal(20, 8)
  uncertainty Decimal?          @db.Decimal(20, 8)
  coverageK   Decimal?          @db.Decimal(6, 2)
  error       Decimal?          @db.Decimal(20, 8)
  empApplied  Decimal?          @db.Decimal(20, 8)
  unit        String?
  ok          Boolean?
  /// within | error_exceeds_emp | in_guard_band | uncertainty_exceeds_emp | missing_uncertainty | emp_zero_at_point
  reason      String?
  sortOrder   Int               @default(0)
  record      CalibrationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, stage, sortOrder])
  @@index([tenantId, recordId])
  @@map("calibration_point")
}

/// Certificado (PDF o imagen) en el storage S3; mismo patrón que FindingAttachment.
model CalibrationAttachment {
  id           String            @id @default(cuid())
  tenantId     String
  recordId     String
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime          @default(now())
  record       CalibrationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordId])
  @@map("calibration_attachment")
}

/// Evaluación del impacto de mediciones pasadas cuando el equipo estaba fuera de tolerancia (ISO 9001 §7.1.5.2).
model ImpactAssessment {
  id                String                   @id @default(cuid())
  tenantId          String
  assetId           String
  triggerRecordId   String?                  @unique
  trigger           ImpactAssessmentTrigger
  /// Fecha del último registro apto; nulo = desde que se empezó a usar.
  windowFrom        DateTime?                @db.Date
  windowTo          DateTime                 @db.Date
  status            ImpactAssessmentStatus   @default(pending)
  outcome           ImpactAssessmentOutcome?
  affectedSummary   String?
  rationale         String?
  completedByUserId String?
  completedAt       DateTime?
  findingId         String?                  @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset             Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  triggerRecord     CalibrationRecord?       @relation(fields: [triggerRecordId], references: [id], onDelete: SetNull)
  finding           Finding?                 @relation(fields: [findingId], references: [id], onDelete: SetNull)
  actions           ImpactAction[]

  @@index([tenantId, assetId])
  @@index([tenantId, status])
  @@map("impact_assessment")
}

/// Seguimiento (Action existente) de una evaluación de impacto.
model ImpactAction {
  id                 String           @id @default(cuid())
  tenantId           String
  impactAssessmentId String
  actionId           String
  createdAt          DateTime         @default(now())
  impactAssessment   ImpactAssessment @relation(fields: [impactAssessmentId], references: [id], onDelete: Cascade)
  action             Action           @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([impactAssessmentId, actionId])
  @@index([actionId])
  @@map("impact_assessment_action")
}

/// Envío del equipo al laboratorio. Mientras returnedAt es nulo el equipo está «en calibración».
model InstrumentShipment {
  id               String    @id @default(cuid())
  tenantId         String
  assetId          String
  sentAt           DateTime  @db.Date
  expectedReturnAt DateTime? @db.Date
  returnedAt       DateTime? @db.Date
  labName          String?
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId, sentAt(sort: Desc)])
  @@map("instrument_shipment")
}

// ─── Accidentabilidad: meta de los índices (Task 17.4) — SPEC-accident-stats.md ───

/// Vincula un índice del tablero con un Indicador de la Task 11c para leer su meta. Solo se lee: los índices
/// se calculan y nunca escriben mediciones. `metric` es `if`, `ig`, `ii` o `id` (CHECK en el SQL de la migración).
model SafetyIndicatorLink {
  id          String    @id @default(cuid())
  tenantId    String
  metric      String
  indicatorId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric])
  @@index([indicatorId])
  @@map("safety_indicator_link")
}

// ─── Inspecciones: auditoría de seguridad en campo (S11) — SPEC-inspections.md ───

/// Meta mensual de auditorías de campo por sede y plantilla. El cumplimiento (hechas / meta) se calcula al leer.
model InspectionTarget {
  id            String             @id @default(cuid())
  tenantId      String
  templateId    String
  siteId        String
  monthlyTarget Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  site          Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([templateId, siteId])
  @@index([tenantId, templateId])
  @@index([siteId])
  @@map("inspection_target")
}

// ─── Seguridad vial (Task 18, ISO 39001) — SPEC-road-safety.md ─────────────
// El evento vial es un IncidentRecord con `isRoad` más un detalle 1:1 (RoadEventDetail). Las fechas
// calendario (@db.Date) viajan como medianoche UTC. Los CHECK (km ≥ 0, internados ≤ lesionados, velocidad
// 0–250, motivo obligatorio en km manual, mes en día 1) viven solo en el SQL de la migración.

enum RoadVehicleKind {
  own
  contractor
  private
  none
}

enum RoadEventType {
  collision_vehicle
  collision_fixed_object
  rollover
  run_off_road
  pedestrian_cyclist
  other
}

enum RoadSurface {
  dry
  wet
  ice_snow
  gravel_dirt
  other
  unknown
}

enum RoadLight {
  day
  dusk_dawn
  night_lit
  night_dark
  unknown
}

enum RoadWeather {
  clear
  rain
  fog
  wind
  snow_ice
  unknown
}

enum RoadSeatbelt {
  all
  some_not
  none
  not_applicable
  unknown
}

enum RoadPropertyDamage {
  none
  minor
  major
}

enum RoadMainCause {
  speed
  fatigue_distraction
  alcohol_drugs
  mechanical
  road_conditions
  other_driver
  weather
  other
  undetermined
}

enum VehicleKmSource {
  odometer
  manual
}

/// Detalle vial del evento (1:1 con una ficha `isRoad`). La persona lesionada sigue en IncidentHealth.
model RoadEventDetail {
  id                String             @id @default(cuid())
  tenantId          String
  incidentRecordId  String             @unique
  vehicleKind       RoadVehicleKind
  /// Obligatorio si `own` (se valida en el dominio y con CHECK).
  assetId           String?
  vehicleLabel      String?
  driverPersonId    String?
  eventType         RoadEventType
  roadSurface       RoadSurface        @default(unknown)
  light             RoadLight          @default(unknown)
  weather           RoadWeather        @default(unknown)
  seatbelt          RoadSeatbelt       @default(unknown)
  estimatedSpeedKmh Int?               @db.SmallInt
  propertyDamage    RoadPropertyDamage @default(none)
  injuredCount      Int                @default(0) @db.SmallInt
  hospitalizedCount Int                @default(0) @db.SmallInt
  fatalCount        Int                @default(0) @db.SmallInt
  mainCause         RoadMainCause      @default(undetermined)
  reportFiled       Boolean            @default(false)
  reportRef         String?
  createdByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentRecord    IncidentRecord     @relation(fields: [incidentRecordId], references: [id], onDelete: Cascade)
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  driver            Person?            @relation(fields: [driverPersonId], references: [id], onDelete: SetNull)

  @@index([tenantId, assetId])
  @@index([tenantId, driverPersonId])
  @@map("road_event_detail")
}

/// Km recorridos por vehículo y mes. Sin fila no hay dato confirmado: la grilla lo calcula de los odómetros.
model VehicleKmPeriod {
  id           String          @id @default(cuid())
  tenantId     String
  assetId      String
  periodMonth  DateTime        @db.Date
  km           Int
  source       VehicleKmSource
  /// Lo que daban los odómetros cuando se pisó a mano (queda como referencia).
  computedKm   Int?
  manualReason String?
  confirmedAt  DateTime?
  actorUserId  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset        Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([tenantId, assetId, periodMonth])
  @@index([tenantId, periodMonth])
  @@map("vehicle_km_period")
}

/// Reinicio o cambio de tablero del odómetro: corta la serie sin estimar km (D14).
model VehicleOdometerReset {
  id          String   @id @default(cuid())
  tenantId    String
  assetId     String
  effectiveOn DateTime @db.Date
  reason      String
  actorUserId String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, effectiveOn])
  @@index([tenantId, assetId])
  @@map("vehicle_odometer_reset")
}

/// Excesos de velocidad cargados a mano por mes (D21); por conductor solo con el ajuste prendido.
model SpeedingPeriod {
  id          String   @id @default(cuid())
  tenantId    String
  assetId     String
  personId    String?
  /// Vacío = total del vehículo; con conductor lleva su id (evita el NULL en el índice único).
  personKey   String   @default("")
  periodMonth DateTime @db.Date
  count       Int
  note        String?
  actorUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([tenantId, assetId, periodMonth, personKey])
  @@index([tenantId, periodMonth])
  @@map("speeding_period")
}

/// Ajustes de la empresa (uno por tenant). Sin fila valen los valores por defecto del dominio.
model RoadSafetySettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  minExposureKm      Int      @default(100000)
  repeatThreshold    Int      @default(2)
  repeatWindowMonths Int      @default(12)
  speedingPerDriver  Boolean  @default(false)
  /// Tarea de conducción (Task 20) cuyos cursos obligatorios definen el manejo defensivo vigente (D20).
  driverTaskId       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverTask         JobTask? @relation(fields: [driverTaskId], references: [id], onDelete: SetNull)

  @@map("road_safety_settings")
}

/// Licencia de conducir de una persona (D20): solo el vencimiento, que carga la empresa. No se valida por jurisdicción.
model DriverLicense {
  id          String   @id @default(cuid())
  tenantId    String
  personId    String
  expiresOn   DateTime @db.Date
  actorUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId])
  @@index([tenantId, expiresOn])
  @@map("driver_license")
}
