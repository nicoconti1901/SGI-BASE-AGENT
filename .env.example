# Copiá este archivo a `.env` y ajustá valores locales.
# Nunca commitees `.env` con secretos reales.

# App — usá el mismo puerto en el que corre `npm run dev` (si 3000 está ocupado, Next usa 3001).
# El auth client ya usa el origen del browser; estos valores son para el servidor / cookies.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="genera-un-secreto-largo-y-aleatorio-de-al-menos-32-chars"

# Postgres local (docker compose)
DATABASE_URL="postgresql://sgi:sgi@localhost:5432/sgi_base?schema=public"

# Seed del superusuario (Task 2)
SEED_SUPERUSER_EMAIL="admin@sgi.local"
SEED_SUPERUSER_PASSWORD="CambiarYa!123"
SEED_SUPERUSER_NAME="Superusuario SGI"
